# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any real keys.

# Supabase project URL and public (anon) key.
# Find them in Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, server-side only. Used by the API route to read the interactions
# table without row-level-security surprises. Never expose this to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Name of the table holding the interaction data.
# Defaults to "drug_interactions".
NEXT_PUBLIC_DRUG_INTERACTIONS_TABLE=drug_interactions
